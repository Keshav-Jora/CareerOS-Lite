rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Custom claims are preferred for managed admins. The verified owner email keeps
    // the single-owner console usable before an Admin SDK claim is provisioned.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true
          && request.auth.token.email in ['kesujora01@gmail.com'])
      );
    }

    match /careerData/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /analytics_events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validAnalyticsEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /analytics_users/{userId} {
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validAnalyticsUser(userId);
      allow read: if isAdmin();
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validFeedback();
      allow read: if isAdmin();
      allow update: if (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenshotUrl', 'updatedAt'])
          && request.resource.data.screenshotUrl is string
          && request.resource.data.updatedAt is timestamp)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['open', 'in_progress', 'closed']
          && request.resource.data.updatedAt is timestamp);
      allow delete: if false;
    }

    function validAnalyticsEvent() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'event', 'userId', 'sessionId', 'timestamp', 'feature', 'provider', 'model', 'responseTime', 'metadata'
        ])
        && data.keys().hasAll(['event', 'userId', 'sessionId', 'timestamp'])
        && data.event in [
          'user_signup', 'user_login', 'user_logout', 'app_open', 'session_start', 'session_end',
          'chat_started', 'chat_completed', 'provider_used', 'provider_failed', 'fallback_used',
          'dashboard_opened', 'roadmap_generated', 'recommendation_opened', 'settings_opened',
          'nova_opened', 'goal_created', 'goal_updated', 'goal_deleted',
          'journey_added', 'certificate_added', 'note_created',
          'feedback_positive', 'feedback_negative', 'ai_error', 'firebase_error', 'app_error'
        ]
        && data.userId is string
        && data.sessionId is string
        && data.timestamp is timestamp
        && (!data.keys().hasAny(['feature']) || data.feature is string)
        && (!data.keys().hasAny(['provider']) || data.provider is string)
        && (!data.keys().hasAny(['model']) || data.model is string)
        && (!data.keys().hasAny(['responseTime']) || (data.responseTime is number && data.responseTime >= 0))
        && (!data.keys().hasAny(['metadata']) || data.metadata is map);
    }

    function validFeedback() {
      let data = request.resource.data;
      return data.keys().hasOnly(['userId', 'rating', 'kind', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'rating', 'kind', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.kind in ['general', 'bug', 'feature']
        && data.message is string && data.message.size() > 0 && data.message.size() <= 4000
        && data.status == 'open'
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validAnalyticsUser(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'providerId', 'joinedAt', 'lastLoginAt', 'lastSeenAt', 'status'])
        && data.keys().hasAll(['uid', 'status', 'lastSeenAt'])
        && data.uid == userId
        && data.status in ['online', 'offline']
        && data.lastSeenAt is timestamp
        && (!data.keys().hasAny(['displayName']) || data.displayName is string || data.displayName == null)
        && (!data.keys().hasAny(['email']) || data.email is string || data.email == null)
        && (!data.keys().hasAny(['photoURL']) || data.photoURL is string || data.photoURL == null)
        && (!data.keys().hasAny(['providerId']) || data.providerId is string)
        && (!data.keys().hasAny(['joinedAt']) || data.joinedAt is timestamp || data.joinedAt == null)
        && (!data.keys().hasAny(['lastLoginAt']) || data.lastLoginAt is timestamp);
    }
  }
}
